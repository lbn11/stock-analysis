# Dockerignore 文件
# 排除不需要打包到Docker镜像的文件和目录

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 测试和覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/

# 数据和日志
*.log
logs/
data/
*.db
*.sqlite
*.sqlite3

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# 文档
*.md
docs/
README*

# 临时文件
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db

# 前端（单独构建）
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.next/

# 环境变量
.env
.env.local
.env.*.local

# 监控和监控配置
monitoring/
nginx/ssl/

# 其他
*.backup
*.bak
.cache/
